#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// u8 accumulator -> f16 (element loop) -> f32 (convert) -> *3 -> f16 -> u8 (element loop), loaded RM, stored ICM?CM:RM.
layout(std430, binding = 0) readonly buffer BA { uint8_t A[]; };
layout(std430, binding = 1) readonly buffer BB { uint8_t B[]; };
layout(std430, binding = 2) readonly buffer BC { float C[]; };
layout(std430, binding = 3) buffer BD { uint8_t D[]; };
void main()
{
   CM(uint8_t, gl_MatrixUseAccumulator) u;
#ifdef ICM
   coopMatLoad(u, A, 0, 16, CMJ);
#else
   coopMatLoad(u, A, 0, 16, RM);
#endif
   CM(float16_t, gl_MatrixUseAccumulator) h;
   for (int i = 0; i < h.length(); i++)
      h[i] = float16_t(u[i]);
   CM(float, gl_MatrixUseAccumulator) f = CM(float, gl_MatrixUseAccumulator)(h);
   f = f * 3.0;
   h = CM(float16_t, gl_MatrixUseAccumulator)(f);
   for (int i = 0; i < h.length(); i++)
      u[i] = uint8_t(uint(h[i]) & 255u);
   coopMatStore(u, D, 0, 16, RM);
}
