+/* 16x16 matrices narrower than the DPAS type of their use (8-bit A/B, or
+ * 8/16-bit accumulators) only ever go to and from memory or get converted to
+ * the DPAS type element by element. D3D12 WMMA (FSR4 through vkd3d-proton)
+ * converts with loops over the element index and expects element i of a
+ * u8 matrix to be element i of the f16/f32 matrix of the same use. Give these
+ * types the field width of the DPAS type (16 bits for A/B, 32 for the
+ * accumulator), so that each invocation holds the same rows and columns, in
+ * the same order, whatever the element size.
+ */
+static unsigned
+cmat_field_bits(struct glsl_cmat_description desc)
+{
+   const unsigned bits = glsl_base_type_get_bit_size(desc.element_type);
+
+   if (desc.rows != 16 || desc.cols != 16)
+      return bits;
+
+   const unsigned dpas_bits = desc.use == GLSL_CMAT_USE_ACCUMULATOR ? 32 : 16;
+   return MAX2(bits, dpas_bits);
+}
+
+static bool
+slice_is_widened(const slice_info *info)
+{
+   return info->field_bits != glsl_base_type_get_bit_size(info->desc.element_type);
+}
+
+/* Split a slice component into its packing_factor elements, at element bit size. */
+static nir_def *
+unpack_fields(nir_builder *b, const slice_info *info, nir_def *packed)
+{
+   const unsigned bits = glsl_base_type_get_bit_size(info->desc.element_type);
+   nir_def *v = info->packing_factor > 1 ?
+      nir_unpack_bits(b, packed, info->field_bits) : packed;
+
+   return info->field_bits != bits ? nir_u2uN(b, v, bits) : v;
+}
+
+/* Inverse of unpack_fields: packing_factor elements into a slice component. */
+static nir_def *
+pack_fields(nir_builder *b, const slice_info *info, nir_def *elems)
+{
+   if (info->field_bits != elems->bit_size)
+      elems = nir_u2uN(b, elems, info->field_bits);
+
+   return info->packing_factor > 1 ? nir_pack_bits(b, elems, 32) : elems;
+}
