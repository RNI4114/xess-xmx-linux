+/* Load or store of a widened slice (cmat_field_bits): one element at a time,
+ * at the row and column lower_cmat_per_element_op assigns to it.
+ */
+static void
+lower_cmat_load_store_widened(nir_builder *b, nir_intrinsic_instr *intrin,
+                              struct lower_cmat_state *state,
+                              const slice_info *info, nir_deref_instr *slice,
+                              nir_deref_instr *pointer, nir_def *stride)
+{
+   const bool load = intrin->intrinsic == nir_intrinsic_cmat_load;
+   const struct glsl_cmat_description desc = info->desc;
+   const unsigned packing_factor = info->packing_factor;
+   const unsigned elem_bits = glsl_base_type_get_bit_size(desc.element_type);
+   const unsigned num_components = glsl_get_vector_elements(slice->type);
+   const bool row_major =
+      nir_intrinsic_matrix_layout(intrin) == GLSL_MATRIX_LAYOUT_ROW_MAJOR;
+
+   pointer = nir_build_deref_cast(b, &pointer->def, pointer->modes,
+                                  glsl_scalar_type(desc.element_type),
+                                  elem_bits / 8);
+
+   const unsigned cols = desc.use != GLSL_CMAT_USE_B ? desc.cols / packing_factor : desc.cols;
+   const unsigned row_step = state->subgroup_size / cols;
+   nir_def *invocation = nir_load_subgroup_invocation(b);
+   nir_def *invocation_div_cols = nir_udiv_imm(b, invocation, cols);
+   nir_def *invocation_mod_cols = nir_umod_imm(b, invocation, cols);
+
+   nir_def *src = load ? NULL : nir_load_deref(b, slice);
+   nir_def *results[NIR_MAX_VEC_COMPONENTS];
+
+   for (unsigned i = 0; i < num_components; i++) {
+      nir_def *row_group = nir_iadd_imm(b, invocation_div_cols, i * row_step);
+      nir_def *elems = load ? NULL : unpack_fields(b, info, nir_channel(b, src, i));
+      nir_def *v[BRW_MAX_PACKING_FACTOR];
+
+      for (unsigned j = 0; j < packing_factor; j++) {
+         nir_def *row, *col;
+         if (desc.use == GLSL_CMAT_USE_B) {
+            row = nir_iadd_imm(b, nir_imul_imm(b, row_group, packing_factor), j);
+            col = invocation_mod_cols;
+         } else {
+            row = row_group;
+            col = nir_iadd_imm(b, nir_imul_imm(b, invocation_mod_cols, packing_factor), j);
+         }
+
+         nir_def *offset = row_major ? nir_iadd(b, nir_imul(b, row, stride), col)
+                                     : nir_iadd(b, nir_imul(b, col, stride), row);
+         nir_deref_instr *memory_deref =
+            nir_build_deref_ptr_as_array(b, pointer,
+                                         nir_i2iN(b, offset, pointer->def.bit_size));
+
+         if (load)
+            v[j] = nir_load_deref(b, memory_deref);
+         else
+            nir_store_deref(b, memory_deref, nir_channel(b, elems, j), 0x1);
+      }
+
+      if (load)
+         results[i] = pack_fields(b, info, nir_vec(b, v, packing_factor));
+   }
+
+   if (load)
+      nir_store_deref(b, slice, nir_vec(b, results, num_components),
+                      nir_component_mask(num_components));
 }
 
