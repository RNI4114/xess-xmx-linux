From 5c46d582fa3bcf8917f5153e276f9fd6ddd951c4 Mon Sep 17 00:00:00 2001
From: askimi <44218719+RNI4114@users.noreply.github.com>
Date: Sun, 18 Oct 2026 19:39:16 -0300
Subject: [PATCH 3/3] intel: rebase onto Mesa main 4c12390be30: keep main's RA
 stride affinity and cmat conversion signedness

Replayed on 4c12390be30, the coopmat commits of this part dropped two
pieces of main: the stride affinity of RA sources in
jay_register_allocate_function and the signedness the convert intrinsic
carries in lower_cmat_convert. Restored as in the merge that was tested.
---
 .../brw/brw_nir_lower_cooperative_matrix.c        | 15 +++++++++++++--
 src/intel/compiler/jay/jay_register_allocate.c    | 10 ++++++++++
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/src/intel/compiler/brw/brw_nir_lower_cooperative_matrix.c b/src/intel/compiler/brw/brw_nir_lower_cooperative_matrix.c
index 7527356f8e9..98ca60d1dc2 100644
--- a/src/intel/compiler/brw/brw_nir_lower_cooperative_matrix.c
+++ b/src/intel/compiler/brw/brw_nir_lower_cooperative_matrix.c
@@ -664,13 +664,24 @@ lower_cmat_convert(nir_builder *b, nir_intrinsic_instr *intrin,
    const unsigned dst_components = glsl_get_vector_elements(dst_info->type);
    const unsigned dst_bits = glsl_base_type_bit_size(dst_info->desc.element_type);
 
+   /* Apply signedness information from convert operation. */
+   const nir_cmat_signed signed_mask = nir_intrinsic_cmat_signed_mask(intrin);
+   struct glsl_cmat_description dst_desc = dst_info->desc;
+   struct glsl_cmat_description src_desc = src_info->desc;
+   dst_desc.element_type =
+      glsl_apply_signedness_to_base_type(
+         (enum glsl_base_type)dst_desc.element_type, signed_mask & NIR_CMAT_RESULT_SIGNED);
+   src_desc.element_type =
+      glsl_apply_signedness_to_base_type(
+         (enum glsl_base_type)src_desc.element_type, signed_mask & NIR_CMAT_A_SIGNED);
+
    /* Widened slices hold their elements where the DPAS type of the same use
     * does, so the conversion is element by element.
     */
    if (slice_is_widened(src_info) || slice_is_widened(dst_info)) {
       assert(src_info->packing_factor == dst_info->packing_factor);
-      const nir_op op = get_cmat_conversion_op(src_info->desc.element_type,
-                                               dst_info->desc.element_type);
+      const nir_op op = get_cmat_conversion_op(src_desc.element_type,
+                                               dst_desc.element_type);
       nir_def *results[NIR_MAX_VEC_COMPONENTS];
 
       for (unsigned i = 0; i < dst_components; i++) {
diff --git a/src/intel/compiler/jay/jay_register_allocate.c b/src/intel/compiler/jay/jay_register_allocate.c
index a449ac393c2..7be454ecdd8 100644
--- a/src/intel/compiler/jay/jay_register_allocate.c
+++ b/src/intel/compiler/jay/jay_register_allocate.c
@@ -1545,6 +1545,16 @@ jay_register_allocate_function(jay_function *f)
             ra.affinities[index].align_offs = c;
          }
 
+         enum jay_stride old_stride = ra.affinities[index].stride;
+         enum jay_stride new_stride = jay_src_stride_minmax(I, s, false);
+         if (old_stride == JAY_NUM_STRIDES || old_stride == new_stride) {
+            ra.affinities[index].stride = new_stride;
+            ra.affinities[index].src_weight =
+               MAX2(ra.affinities[index].src_weight, block->weight);
+         } else {
+            ra.affinities[index].mixed_stride = true;
+         }
+
          /* A later scalar use (e.g. the loop back-edge phi source of a DPAS
           * accumulator) must not erase the vector affinity an earlier use
           * gave the web, or the web loses its alignment and every iteration
