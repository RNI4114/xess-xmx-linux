+/* LOCAL (rt-profiling/morta): forget the GPU-side wait state of a semaphore
+ * before its vk_sync can be reused by another one (see anv_xq_* in
+ * xe/anv_batch_chain.c).
+ */
+VKAPI_ATTR void VKAPI_CALL
+anv_DestroySemaphore(VkDevice _device, VkSemaphore _semaphore,
+                     const VkAllocationCallbacks *pAllocator)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   VK_FROM_HANDLE(vk_semaphore, semaphore, _semaphore);
+
+   if (semaphore && device->info->kmd_type == INTEL_KMD_TYPE_XE) {
+      anv_xq_forget_sync(device, &semaphore->permanent);
+      anv_xq_forget_sync(device, semaphore->temporary);
+   }
+
+   vk_common_DestroySemaphore(_device, _semaphore, pAllocator);
+}
diff --git a/src/intel/vulkan/genX_cmd_buffer.c b/src/intel/vulkan/genX_cmd_buffer.c
index 3d1daf3e5ea..2387a0f2893 100644
--- a/src/intel/vulkan/genX_cmd_buffer.c
+++ b/src/intel/vulkan/genX_cmd_buffer.c
@@ -3597,6 +3597,71 @@ genX(batch_emit_pipe_control_write)(struct anv_batch *batch,
                      post_sync_op, address, imm_data, bits);
 }
 
+/* LOCAL (rt-profiling/morta): GPU-side cross-queue waits.
+ *
+ * The waits run at the start of a submission, after the kernel already
+ * invalidated the caches for it, so nothing stale can have been loaded on
+ * this engine while polling; the invalidation below is only belt and braces.
+ */
+void
+genX(xq_emit_waits)(struct anv_batch *batch,
+                    const struct intel_device_info *devinfo,
+                    const uint64_t *addrs, const uint32_t *vals,
+                    uint32_t count)
+{
+   for (uint32_t i = 0; i < count; i++) {
+      anv_batch_emit(batch, GENX(MI_SEMAPHORE_WAIT), sem) {
+         sem.WaitMode            = PollingMode;
+         sem.CompareOperation    = COMPARE_SAD_GREATER_THAN_OR_EQUAL_SDD;
+         sem.SemaphoreDataDword  = vals[i];
+         sem.SemaphoreAddress    = (struct anv_address) { NULL, addrs[i] };
+      }
+   }
+   if (count) {
+      genx_batch_emit_pipe_control(batch, devinfo, GPGPU,
+                                   ANV_PIPE_CS_STALL_BIT |
+                                   ANV_PIPE_STATE_CACHE_INVALIDATE_BIT |
+                                   ANV_PIPE_CONSTANT_CACHE_INVALIDATE_BIT |
+                                   ANV_PIPE_TEXTURE_CACHE_INVALIDATE_BIT |
+                                   ANV_PIPE_INSTRUCTION_CACHE_INVALIDATE_BIT);
+   }
+}
+
+/* Flush everything the submission wrote, then publish the semaphore values.
+ * current_pipeline is the pipeline the batch was left in (UINT32_MAX when the
+ * submission never selected one, i.e. did no 3D/compute work).
+ */
+void
+genX(xq_emit_signals)(struct anv_batch *batch,
+                      const struct intel_device_info *devinfo,
+                      uint32_t current_pipeline,
+                      const uint64_t *addrs, const uint32_t *vals,
+                      uint32_t count)
+{
+   const uint32_t pipe = current_pipeline == _3D ? _3D : GPGPU;
+   enum anv_pipe_bits flush = ANV_PIPE_FLUSH_BITS | ANV_PIPE_CS_STALL_BIT;
+   static int light = -1;
+   if (light < 0)
+      light = debug_get_num_option("ANV_XQ_LIGHT", 0);
+   if (light == 1)  /* L1 only: the L3 is shared by all engines */
+      flush = ANV_PIPE_HDC_PIPELINE_FLUSH_BIT |
+              ANV_PIPE_UNTYPED_DATAPORT_CACHE_FLUSH_BIT |
+              ANV_PIPE_RENDER_TARGET_CACHE_FLUSH_BIT |
+              ANV_PIPE_DEPTH_CACHE_FLUSH_BIT | ANV_PIPE_CS_STALL_BIT;
+   else if (light == 2)
+      flush = ANV_PIPE_CS_STALL_BIT;
+   if (pipe != _3D)
+      flush &= ~ANV_PIPE_GFX_BITS;
+   genx_batch_emit_pipe_control(batch, devinfo, pipe, flush);
+
+   for (uint32_t i = 0; i < count; i++) {
+      const struct anv_address addr = { NULL, addrs[i] };
+      genx_batch_emit_pipe_control_write(batch, devinfo, pipe,
+                                         WriteImmediateData, addr,
+                                         vals[i], ANV_PIPE_CS_STALL_BIT);
+   }
+}
+
 /* Set preemption on/off. */
 void
 genX(batch_set_preemption)(struct anv_batch *batch,
diff --git a/src/intel/vulkan/xe/anv_batch_chain.c b/src/intel/vulkan/xe/anv_batch_chain.c
index 6543691dce5..aac3c4b0085 100644
--- a/src/intel/vulkan/xe/anv_batch_chain.c
+++ b/src/intel/vulkan/xe/anv_batch_chain.c
@@ -28,6 +28,10 @@
 #include "common/intel_bind_timeline.h"
 #include "common/xe/intel_gem.h"
 #include "perf/intel_perf.h"
+#include "util/hash_table.h"
+#include "util/u_debug.h"
+#include "vk_drm_syncobj.h"
+#include "genxml/gen90_pack.h"
 
 #include "drm-uapi/xe_drm.h"
 
@@ -274,6 +278,276 @@ xe_companion_rcs_queue_exec_locked(struct anv_queue *queue,
    return result;
 }
 
+
+/* LOCAL (rt-profiling/morta): waits between queues without the kernel.
+ *
+ * vkd3d-proton turns every D3D12 queue Wait into a timeline semaphore wait,
+ * which xe turns into a drm_sched dependency: the job is only handed to the
+ * GuC after the signaling job completed, its fence IRQ was handled and the
+ * scheduler worker ran (~70-130 us on BMG, several times per frame).
+ *
+ * - same queue: a wait on a value already signaled by an earlier submission
+ *   of this same queue is dropped; jobs of one exec queue run in order with
+ *   a flush + CS stall between them.
+ * - cross queue: semaphores that get waited on from another queue become
+ *   "hot". Submissions that signal a hot semaphore end with a flush and a
+ *   memory write of the value into a per-semaphore slot (the last command
+ *   buffer jumps to a small tail batch), and a later wait on a value whose
+ *   signal submission was already handed to the kernel polls that slot with
+ *   MI_SEMAPHORE_WAIT at the start of the waiting submission instead.
+ *
+ * Only for timeline, non-shareable semaphores always signaled by one queue,
+ * with 32-bit values. By default only the compute engine polls: on BMG an
+ * active render context (even just polling) makes the compute engine about
+ * 2.5x slower, while a polling compute context does not hurt the render
+ * engine (morta/xqtest). ANV_XQ=0 disables it, ANV_XQ_SAME/ANV_XQ_CROSS=0 each
+ * half.
+ */
+struct anv_xq_sem {
+   uint32_t slot;
+   struct anv_queue *owner;
+   uint64_t max_any;   /* highest value signaled by owner, submitted */
+   uint64_t max_tail;  /* highest value published to the slot, submitted */
+   bool poisoned;
+   bool hot;
+};
+
+#define XQ_SLOT_STRIDE 64
+#define XQ_RING_ENTRY 512
+#define XQ_MAX 8
+
+void
+anv_xq_init(struct anv_device *device)
+{
+   device->xq.enabled = debug_get_bool_option("ANV_XQ", true);
+   device->xq.same = debug_get_bool_option("ANV_XQ_SAME", true);
+   device->xq.cross = debug_get_bool_option("ANV_XQ_CROSS", true);
+   simple_mtx_init(&device->xq.mutex, mtx_plain);
+   device->xq.sems = _mesa_pointer_hash_table_create(NULL);
+   if (!device->xq.enabled || !device->xq.sems)
+      goto disable;
+
+   device->xq.num_slots = 4096;
+   const enum anv_bo_alloc_flags slot_flags =
+      debug_get_bool_option("ANV_XQ_SMEM", false) ?
+      (ANV_BO_ALLOC_NO_LOCAL_MEM | ANV_BO_ALLOC_HOST_COHERENT) : 0;
+   if (anv_device_alloc_bo(device, "xq-slots",
+                           device->xq.num_slots * XQ_SLOT_STRIDE, slot_flags, 0,
+                           &device->xq.slots_bo) != VK_SUCCESS)
+      goto disable;
+
+   device->xq.ring_entries = 4096;
+   if (anv_device_alloc_bo(device, "xq-ring",
+                           device->xq.ring_entries * XQ_RING_ENTRY,
+                           ANV_BO_ALLOC_BATCH_BUFFER_INTERNAL_FLAGS, 0,
+                           &device->xq.ring_bo) != VK_SUCCESS) {
+      anv_device_release_bo(device, device->xq.slots_bo);
+      device->xq.slots_bo = NULL;
+      goto disable;
+   }
+   return;
+
+disable:
+   device->xq.enabled = false;
+}
+
+void
+anv_xq_finish(struct anv_device *device)
+{
+   if (!device->xq.sems)
+      return;
+   if (debug_get_bool_option("ANV_XQ_STATS", false)) {
+      fprintf(stderr, "ANV_XQ: same-queue waits dropped %llu, cross-queue waits on GPU %llu, kept %llu, sems %u\n",
+              (unsigned long long)device->xq.stat_same,
+              (unsigned long long)device->xq.stat_cross,
+              (unsigned long long)device->xq.stat_kept, device->xq.next_slot);
+   }
+   if (device->xq.ring_bo)
+      anv_device_release_bo(device, device->xq.ring_bo);
+   if (device->xq.slots_bo)
+      anv_device_release_bo(device, device->xq.slots_bo);
+   if (device->xq.sems) {
+      hash_table_foreach(device->xq.sems, e)
+         free(e->data);
+      _mesa_hash_table_destroy(device->xq.sems, NULL);
+   }
+   simple_mtx_destroy(&device->xq.mutex);
+}
+
+void
+anv_xq_forget_sync(struct anv_device *device, struct vk_sync *sync)
+{
+   if (!device->xq.sems || !sync)
+      return;
+   simple_mtx_lock(&device->xq.mutex);
+   struct hash_entry *e = _mesa_hash_table_search(device->xq.sems, sync);
+   if (e) {
+      free(e->data);
+      _mesa_hash_table_remove(device->xq.sems, e);
+   }
+   simple_mtx_unlock(&device->xq.mutex);
+}
+
+static bool
+xq_sync_ok(const struct vk_sync *sync)
+{
+   return (sync->flags & VK_SYNC_IS_TIMELINE) &&
+          !(sync->flags & VK_SYNC_IS_SHAREABLE) &&
+          vk_sync_type_is_drm_syncobj(sync->type);
+}
+
+static uint64_t
+xq_slot_addr(struct anv_device *device, const struct anv_xq_sem *xs)
+{
+   return device->xq.slots_bo->offset + (uint64_t)xs->slot * XQ_SLOT_STRIDE;
+}
+
+struct xq_plan {
+   uint32_t nw, ns, nupd;
+   uint64_t waddr[XQ_MAX], saddr[XQ_MAX];
+   uint32_t wval[XQ_MAX], sval[XQ_MAX];
+   struct anv_xq_sem *upd[2 * XQ_MAX];
+   uint64_t upd_val[2 * XQ_MAX];
+   bool upd_tail[2 * XQ_MAX];
+   uint32_t same, kept;
+};
+
+/* Decides which waits stay kernel dependencies (copied to kept_waits) and
+ * which semaphore values get published by this submission.
+ */
+static void
+xq_plan(struct anv_queue *queue, bool can_head, bool can_tail,
+        uint32_t wait_count, const struct vk_sync_wait *waits,
+        uint32_t signal_count, const struct vk_sync_signal *signals,
+        struct vk_sync_wait *kept_waits, uint32_t *kept_count,
+        struct xq_plan *plan)
+{
+   struct anv_device *device = queue->device;
+   memset(plan, 0, sizeof(*plan));
+   *kept_count = 0;
+
+   simple_mtx_lock(&device->xq.mutex);
+   for (uint32_t i = 0; i < wait_count; i++) {
+      const struct vk_sync_wait *w = &waits[i];
+      struct hash_entry *he = xq_sync_ok(w->sync) ?
+         _mesa_hash_table_search(device->xq.sems, w->sync) : NULL;
+      struct anv_xq_sem *xs = he ? he->data : NULL;
+
+      if (xs && !xs->poisoned && xs->owner == queue) {
+         if (device->xq.same && xs->max_any >= w->wait_value) {
+            plan->same++;
+            continue;
+         }
+      } else if (xs && !xs->poisoned && xs->owner) {
+         xs->hot = true;
+         static int only = -1;
+         if (only < 0)
+            only = debug_get_num_option("ANV_XQ_ONLY", 2); /* 0 all, 1 render, 2 compute */
+         const bool eng_ok = only == 0 ||
+            (only == 1 && queue->family->engine_class == INTEL_ENGINE_CLASS_RENDER) ||
+            (only == 2 && queue->family->engine_class == INTEL_ENGINE_CLASS_COMPUTE);
+         if (device->xq.cross && eng_ok && can_head && plan->nw < XQ_MAX &&
+             xs->max_tail >= w->wait_value) {
+            plan->waddr[plan->nw] = xq_slot_addr(device, xs);
+            plan->wval[plan->nw] = w->wait_value;
+            plan->nw++;
+            continue;
+         }
+      }
+      kept_waits[(*kept_count)++] = *w;
+      plan->kept++;
+   }
+
+   for (uint32_t i = 0; i < signal_count; i++) {
+      const struct vk_sync_signal *sg = &signals[i];
+      if (!xq_sync_ok(sg->sync))
+         continue;
+      struct hash_entry *he = _mesa_hash_table_search(device->xq.sems, sg->sync);
+      struct anv_xq_sem *xs = he ? he->data : NULL;
+      if (!xs) {
+         if (device->xq.next_slot >= device->xq.num_slots)
+            continue;
+         xs = calloc(1, sizeof(*xs));
+         if (!xs)
+            continue;
+         xs->slot = device->xq.next_slot++;
+         _mesa_hash_table_insert(device->xq.sems, sg->sync, xs);
+      }
+      if (!xs->owner)
+         xs->owner = queue;
+      else if (xs->owner != queue)
+         xs->poisoned = true;
+      if (sg->signal_value > UINT32_MAX)
+         xs->poisoned = true;
+      if (xs->poisoned || plan->nupd >= ARRAY_SIZE(plan->upd))
+         continue;
+
+      bool tail = xs->hot && device->xq.cross && can_tail && plan->ns < XQ_MAX;
+      if (tail) {
+         plan->saddr[plan->ns] = xq_slot_addr(device, xs);
+         plan->sval[plan->ns] = sg->signal_value;
+         plan->ns++;
+      }
+      plan->upd[plan->nupd] = xs;
+      plan->upd_val[plan->nupd] = sg->signal_value;
+      plan->upd_tail[plan->nupd] = tail;
+      plan->nupd++;
+   }
+   simple_mtx_unlock(&device->xq.mutex);
+}
+
+static void
+xq_commit(struct anv_device *device, struct xq_plan *plan)
+{
+   simple_mtx_lock(&device->xq.mutex);
+   for (uint32_t i = 0; i < plan->nupd; i++) {
+      struct anv_xq_sem *xs = plan->upd[i];
+      xs->max_any = MAX2(xs->max_any, plan->upd_val[i]);
+      if (plan->upd_tail[i])
+         xs->max_tail = MAX2(xs->max_tail, plan->upd_val[i]);
+   }
+   device->xq.stat_same += plan->same;
+   device->xq.stat_cross += plan->nw;
+   device->xq.stat_kept += plan->kept;
+   simple_mtx_unlock(&device->xq.mutex);
+}
+
+static struct anv_batch
+xq_ring_batch(struct anv_device *device, struct anv_queue *queue, uint64_t *addr)
+{
+   simple_mtx_lock(&device->xq.mutex);
+   uint32_t idx = device->xq.ring_next++ % device->xq.ring_entries;
+   simple_mtx_unlock(&device->xq.mutex);
+   void *map = device->xq.ring_bo->map + (size_t)idx * XQ_RING_ENTRY;
+   *addr = device->xq.ring_bo->offset + (uint64_t)idx * XQ_RING_ENTRY;
+   return (struct anv_batch) {
+      .start = map,
+      .next = map,
+      .end = map + XQ_RING_ENTRY,
+      .engine_class = queue->family->engine_class,
+   };
+}
+
+static void
+xq_emit_jump(struct anv_batch *batch, uint64_t addr)
+{
+   struct GFX9_MI_BATCH_BUFFER_START bbs = {
+      __anv_cmd_header(GFX9_MI_BATCH_BUFFER_START),
+      .SecondLevelBatchBuffer  = Firstlevelbatch,
+      .AddressSpaceIndicator   = ASI_PPGTT,
+      .BatchBufferStartAddress = (struct anv_address) { NULL, addr },
