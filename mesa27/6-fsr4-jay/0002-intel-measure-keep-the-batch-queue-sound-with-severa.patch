From 18b582bede631493928af48e28f09637a94f5e84 Mon Sep 17 00:00:00 2001
From: askimi <44218719+RNI4114@users.noreply.github.com>
Date: Sun, 18 Oct 2026 11:55:26 -0300
Subject: [PATCH 2/9] intel/measure: keep the batch queue sound with several
 queues and reused command buffers

INTEL_MEASURE corrupted its queue of submitted batches under vkd3d-proton
(D3D12 graphics, compute and copy queues, command buffers reset and
resubmitted constantly) and took the game down (Cyberpunk 2077 crashed in
vkBeginCommandBuffer within a few frames; vkd3d-proton's queue tests hit
'intel_measure_ready: batch->index > 1').

- gather collects every ready batch instead of stopping at the first one
  still running: batches from different queues complete out of order.
- reset and destroy take the command buffer's batch out of the queue first
  (intel_measure_forget_batch, publishing it if the GPU is done), so the
  queue never keeps the old contents or freed memory.
- when capture ends, reset frees the batch instead of leaking it.
- the resubmit-without-reset check tested the wrong thing: a batch alone
  in the queue was added again, and a collected one (unlinked) was
  dereferenced through NULL. Collected batches are now self-linked.

vkd3d-proton test_*queue* (18.9M checks) pass with INTEL_MEASURE on.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/intel/common/intel_measure.c | 44 +++++++++++++++++++++++++-------
 src/intel/common/intel_measure.h |  2 ++
 src/intel/vulkan/anv_measure.c   | 22 +++++++++++-----
 3 files changed, 53 insertions(+), 15 deletions(-)

diff --git a/src/intel/common/intel_measure.c b/src/intel/common/intel_measure.c
index 14e7676c593..789f1392ba6 100644
--- a/src/intel/common/intel_measure.c
+++ b/src/intel/common/intel_measure.c
@@ -398,6 +398,33 @@ raw_timestamp_delta(uint64_t time0, uint64_t time1)
  *
  * Rendering is complete when the last timestamp has been written.
 */
+static void
+intel_measure_push_result(struct intel_measure_device *device,
+                          struct intel_measure_batch *batch);
+
+/**
+ * Take a batch out of the queue of submitted batches before its command
+ * buffer is reset or freed: publish it if the GPU has finished it, drop it
+ * otherwise. Applications reset command buffers whose batch is still queued
+ * (all of them through vkd3d-proton, and on several queues), and the queue
+ * must not keep pointing at the old contents or the freed memory.
+ */
+void
+intel_measure_forget_batch(struct intel_measure_device *measure_device,
+                           struct intel_measure_batch *batch)
+{
+   pthread_mutex_lock(&measure_device->mutex);
+
+   if (batch->link.next && batch->link.next != &batch->link) {
+      if (batch->index > 1 && intel_measure_ready(batch))
+         intel_measure_push_result(measure_device, batch);
+      list_del(&batch->link);
+   }
+   list_inithead(&batch->link);
+
+   pthread_mutex_unlock(&measure_device->mutex);
+}
+
 bool
 intel_measure_ready(struct intel_measure_batch *batch)
 {
@@ -703,23 +730,22 @@ intel_measure_gather(struct intel_measure_device *measure_device,
 {
    pthread_mutex_lock(&measure_device->mutex);
 
-   /* Iterate snapshots and collect if ready.  Each snapshot queue will be
-    * in-order, but we must determine which queue has the oldest batch.
+   /* Collect every batch that is ready. The list is in submission order, but
+    * batches from different queues complete out of that order (D3D12 through
+    * vkd3d-proton keeps graphics, compute and copy queues busy at once), so a
+    * batch still running on one queue must not hold back the others.
     */
-   /* iterate snapshots and collect if ready */
-   while (!list_is_empty(&measure_device->queued_snapshots)) {
-      struct intel_measure_batch *batch =
-         list_first_entry(&measure_device->queued_snapshots,
-                          struct intel_measure_batch, link);
-
+   list_for_each_entry_safe(struct intel_measure_batch, batch,
+                            &measure_device->queued_snapshots, link) {
       if (!intel_measure_ready(batch)) {
          /* command buffer has begun execution on the gpu, but has not
           * completed.
           */
-         break;
+         continue;
       }
 
       list_del(&batch->link);
+      list_inithead(&batch->link);   /* out of the queue (see _anv_measure_submit) */
       assert(batch->index % 2 == 0);
 
       intel_measure_push_result(measure_device, batch);
diff --git a/src/intel/common/intel_measure.h b/src/intel/common/intel_measure.h
index 507f2fd9777..aba13aef068 100644
--- a/src/intel/common/intel_measure.h
+++ b/src/intel/common/intel_measure.h
@@ -182,6 +182,8 @@ bool intel_measure_state_changed(const struct intel_measure_batch *batch,
 void intel_measure_frame_transition(unsigned frame);
 
 bool intel_measure_ready(struct intel_measure_batch *batch);
+void intel_measure_forget_batch(struct intel_measure_device *measure_device,
+                                struct intel_measure_batch *batch);
 
 struct intel_device_info;
 void intel_measure_print_cpu_result(unsigned int frame,
diff --git a/src/intel/vulkan/anv_measure.c b/src/intel/vulkan/anv_measure.c
index 3e16de39dae..211b0778e52 100644
--- a/src/intel/vulkan/anv_measure.c
+++ b/src/intel/vulkan/anv_measure.c
@@ -305,7 +305,10 @@ anv_measure_reset(struct anv_cmd_buffer *cmd_buffer)
       return;
 
    if (!config->enabled) {
-      cmd_buffer->measure = NULL;
+      /* Capture is over: free this command buffer's batch (it may still be
+       * queued for collection) instead of leaking it.
+       */
+      anv_measure_destroy(cmd_buffer);
       return;
    }
 
@@ -316,9 +319,11 @@ anv_measure_reset(struct anv_cmd_buffer *cmd_buffer)
       return anv_measure_init(cmd_buffer);
    }
 
-   /* it is possible that the command buffer contains snapshots that have not
-    * yet been processed
+   /* the batch of the previous recording may still be queued for collection
+    * (on another queue's timeline than the batches ahead of it): take it out
+    * before its snapshots are overwritten
     */
+   intel_measure_forget_batch(&device->physical->measure_device, &measure->base);
    intel_measure_gather(&device->physical->measure_device,
                         device->info);
 
@@ -328,7 +333,6 @@ anv_measure_reset(struct anv_cmd_buffer *cmd_buffer)
    measure->base.renderpass = 0;
    measure->base.frame = 0;
    measure->base.event_count = 0;
-   list_inithead(&measure->base.link);
 }
 
 void
@@ -345,8 +349,10 @@ anv_measure_destroy(struct anv_cmd_buffer *cmd_buffer)
       return;
 
    /* it is possible that the command buffer contains snapshots that have not
-    * yet been processed
+    * yet been processed, and its batch may still be queued: take it out of the
+    * queue before the memory goes away
     */
+   intel_measure_forget_batch(&physical->measure_device, &measure->base);
    intel_measure_gather(&physical->measure_device, &physical->info);
 
    if (measure->bo != NULL)
@@ -392,7 +398,11 @@ _anv_measure_submit(struct anv_cmd_buffer *cmd_buffer)
        base->index == 0 /* no snapshots were started */ )
       return;
 
-   if (measure->base.link.next->prev != measure->base.link.next->next) {
+   /* Still queued from an earlier submission (resubmitted without a reset).
+    * A batch out of the queue is unlinked (fresh, memset) or self-linked
+    * (collected or forgotten).
+    */
+   if (list_is_linked(&measure->base.link) && !list_is_empty(&measure->base.link)) {
       fprintf(stderr, "INTEL_MEASURE: not tracking events from reused"
                       "command buffer without reset. Not supported.\n");
       return;
