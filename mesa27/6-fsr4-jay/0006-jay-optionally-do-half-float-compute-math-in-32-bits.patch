diff --git a/src/intel/compiler/jay/jay_nir_promote_f16.c b/src/intel/compiler/jay/jay_nir_promote_f16.c
new file mode 100644
index 00000000000..313e9e687b0
--- /dev/null
+++ b/src/intel/compiler/jay/jay_nir_promote_f16.c
@@ -0,0 +1,82 @@
+/*
+ * Copyright 2026 Intel Corporation
+ * SPDX-License-Identifier: MIT
+ */
+
+/**
+ * Do 16-bit float arithmetic in 32 bits (INTEL_PROMOTE_F16=1, off by default).
+ *
+ * Not exact: intermediate results are no longer rounded to half precision.
+ * What it saves is layout traffic. A float to half conversion writes a
+ * dword-strided half while the 3-source half instructions need packed
+ * halves, and halves unpacked from a dword have the same problem, so mixed
+ * half/float code (as FSR4's preprocessing through vkd3d-proton) spends about
+ * half its instructions on copies between the two layouts.
+ */
+
+#include "compiler/nir/nir_builder.h"
+#include "util/u_debug.h"
+#include "jay_private.h"
+
+static unsigned
+promote_cb(const nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_alu)
+      return 0;
+
+   const nir_alu_instr *alu = nir_instr_as_alu(instr);
+   const nir_op_info *info = &nir_op_infos[alu->op];
+   if (alu->def.bit_size != 16 || info->is_conversion ||
+       nir_alu_type_get_base_type(info->output_type) != nir_type_float)
+      return 0;
+
+   for (unsigned i = 0; i < info->num_inputs; i++) {
+      if (nir_alu_type_get_base_type(info->input_types[i]) != nir_type_float)
+         return 0;
+   }
+   return 32;
+}
+
+static bool
+fold_round_trip(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   /* f2f32(f2f16(x)) -> x for a 32-bit x */
+   if (alu->op != nir_op_f2f32 || alu->def.num_components != 1)
+      return false;
+
+   nir_alu_instr *src = nir_src_as_alu(alu->src[0].src);
+   if (!src || (src->op != nir_op_f2f16 && src->op != nir_op_f2f16_rtne &&
+                src->op != nir_op_f2f16_rtz) ||
+       src->src[0].src.ssa->bit_size != 32)
+      return false;
+
+   b->cursor = nir_before_instr(&alu->instr);
+   const unsigned c = src->src[0].swizzle[alu->src[0].swizzle[0]];
+   nir_def_replace(&alu->def, nir_channel(b, src->src[0].src.ssa, c));
+   return true;
+}
+
+bool
+jay_nir_promote_f16(nir_shader *nir)
+{
+   /* Compute only (FSR4's passes): graphics shaders keep the half throughput.
+    * Cooperative matrix code is laid out for its half types.
+    */
+   if (!debug_get_bool_option("INTEL_PROMOTE_F16", false) ||
+       nir->info.stage != MESA_SHADER_COMPUTE ||
+       nir->info.cs.has_cooperative_matrix)
+      return false;
+
+   bool progress = false;
+   NIR_PASS(progress, nir, nir_lower_bit_size, promote_cb, NULL);
+   if (!progress)
+      return false;
+
+   NIR_PASS(_, nir, nir_opt_constant_folding);
+   NIR_PASS(_, nir, nir_shader_alu_pass, fold_round_trip,
+            nir_metadata_control_flow, NULL);
+   NIR_PASS(_, nir, nir_opt_copy_prop);
+   NIR_PASS(_, nir, nir_opt_algebraic);
+   NIR_PASS(_, nir, nir_opt_dce);
+   return true;
+}
