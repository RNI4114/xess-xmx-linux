 src/intel/compiler/jay/jay_nir_promote_f16.c | 82 ++++++++++++++++++++
 src/intel/compiler/jay/jay_private.h         |  1 +
 src/intel/compiler/jay/meson.build           |  1 +
 4 files changed, 85 insertions(+)
 create mode 100644 src/intel/compiler/jay/jay_nir_promote_f16.c

