index 6df72b2ff82..318eca19eb1 100644
--- a/src/vulkan/runtime/vk_acceleration_structure.c
+++ b/src/vulkan/runtime/vk_acceleration_structure.c
@@ -1350,6 +1350,8 @@ vk_cmd_build_acceleration_structures(VkCommandBuffer commandBuffer,
       }
 
       }
+      /* Drivers may batch the fills until the next flush. */
+      device->flush_buffer_write_cp(commandBuffer);
       vk_bvh_build_barrier_transfer_to_compute(commandBuffer);
       vk_bvh_build_barrier_compute_to_compute(commandBuffer, false);
 
