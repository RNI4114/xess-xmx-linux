 enum bvh_dump_type {
diff --git a/src/intel/vulkan/bvh/anv_bvh_defines.h b/src/intel/vulkan/bvh/anv_bvh_defines.h
index c15d84b8bf6..f38eff92a12 100644
--- a/src/intel/vulkan/bvh/anv_bvh_defines.h
+++ b/src/intel/vulkan/bvh/anv_bvh_defines.h
@@ -489,4 +489,31 @@ struct copy_args {
    uint8_t accel_struct_compat[VK_UUID_SIZE];
 };
 
+/* init.comp: the small scratch initializations of one vkCmdBuild* call
+ * (IR headers, sort counters, refit arrival counters...) in one dispatch.
+ * Workgroup (x, y) writes dwords [y * ANV_BVH_INIT_CHUNK, +ANV_BVH_INIT_CHUNK)
+ * of op x.
+ */
+#define ANV_BVH_INIT_WG_SIZE 64
+#define ANV_BVH_INIT_CHUNK   4096
+#define ANV_BVH_INIT_FILL    0xffffffffu
+
+struct bvh_init_op {
+   VOID_REF dst;
+   uint32_t dwords;
+   /* dword index in bvh_init_args::data, or ANV_BVH_INIT_FILL */
+   uint32_t src;
+   uint32_t value;
+   uint32_t pad;
+};
+
+struct bvh_init_args {
+   VOID_REF ops;
+   VOID_REF data;
+};
+
+#ifdef VULKAN
+TYPE(bvh_init_op, 8);
+#endif
+
 #endif
diff --git a/src/intel/vulkan/bvh/init.comp b/src/intel/vulkan/bvh/init.comp
new file mode 100644
index 00000000000..df73f92528f
--- /dev/null
+++ b/src/intel/vulkan/bvh/init.comp
@@ -0,0 +1,36 @@
+/* Copyright © 2026 Intel Corporation
+ * SPDX-License-Identifier: MIT
+ *
+ * Batched scratch initialization for one vkCmdBuildAccelerationStructures
+ * call: every op is a copy of a few dwords (IR headers) or a fill (sort and
+ * refit counters).  One dispatch replaces a blorp op per BLAS.
+ */
+
+#version 460
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+#include "anv_bvh_defines.h"
+#define VK_USED_BUILD_FLAGS (0)
+#include "anv_bvh_helpers.h"
+
+layout(push_constant) uniform CONSTS {
+   bvh_init_args args;
+};
+
+void
+main(void)
+{
+   REF(bvh_init_op) op = INDEX(bvh_init_op, args.ops, gl_WorkGroupID.x);
+   uint32_t dwords = DEREF(op).dwords;
+   uint32_t src = DEREF(op).src;
+   uint32_t value = DEREF(op).value;
+   VOID_REF dst = DEREF(op).dst;
+
+   uint32_t begin = gl_WorkGroupID.y * ANV_BVH_INIT_CHUNK;
+   uint32_t end = min(begin + ANV_BVH_INIT_CHUNK, dwords);
+   for (uint32_t i = begin + gl_LocalInvocationID.x; i < end; i += ANV_BVH_INIT_WG_SIZE) {
+      uint32_t v = src == ANV_BVH_INIT_FILL ? value : DEREF(INDEX(uint32_t, args.data, src + i));
+      DEREF(INDEX(uint32_t, dst, i)) = v;
+   }
+}
