index 7e8175d93ca..1552c6ffac4 100644
--- a/src/intel/vulkan/bvh/meson.build
+++ b/src/intel/vulkan/bvh/meson.build
@@ -10,6 +10,7 @@ bvh_shaders = [
   'copy.comp',
