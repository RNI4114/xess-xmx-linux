From 18e5bb665c1a58b1087ef43e2d719c861a2f2f80 Mon Sep 17 00:00:00 2001
From: askimi <44218719+RNI4114@users.noreply.github.com>
Date: Mon, 5 Oct 2026 00:56:33 -0300
Subject: [PATCH 18/21] vulkan/bvh, anv: wide morton sort for big BLAS too

Generalize morton_sort_kvs_per_thread_64 into
morton_sort_kvs_per_thread_large + morton_sort_large_leaf_count: 64-bit
key sorts and builds of at least that many leaves get the wide variant,
selected with a new VK_BUILD_FLAG_WIDE_SORT (part of the morton pipeline
key). The sort-internal scratch stays sized for the narrow sort, since the
size query sees the max primitive count.

ANV: 4 key-values per thread from 16k leaves. Cyberpunk rebuilds a
210k-triangle BLAS every ~33 frames (a frame time spike):
tlascheck TC_BIG=210000: 1.346 -> 1.179 ms; small BLAS and TLAS unchanged.
Validated (1k-100k instances, big/small/mixed BLAS), rtcheck clean.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
(cherry picked from commit 5a0d5f722f850c77ee0a87d6d4bfbdc76c3b8cc8)
(cherry picked from commit b3d4dd7f8ebd403e8daa5ad3042d8a7e4f8a26ed)
---
 .../vulkan/genX_acceleration_structure.c      |  8 +++---
 src/vulkan/runtime/bvh/vk_bvh_defines.h       |  6 +++--
 .../runtime/vk_acceleration_structure.c       | 25 +++++++++++++------
 .../runtime/vk_acceleration_structure.h       | 10 +++++---
 4 files changed, 32 insertions(+), 17 deletions(-)

diff --git a/src/intel/vulkan/genX_acceleration_structure.c b/src/intel/vulkan/genX_acceleration_structure.c
index 23c09d2ae04..a1d4b9be41a 100644
--- a/src/intel/vulkan/genX_acceleration_structure.c
+++ b/src/intel/vulkan/genX_acceleration_structure.c
@@ -1249,9 +1249,11 @@ anv_device_init_accel_struct_build_state(struct anv_device *device)
          .subgroup_size = device->info->ver >= 20 ? 32 : 16,
          .morton_sort_workgroup_size = 512,
          .morton_sort_kvs_per_thread = 2,
-         /* TLAS (64-bit keys): 43k instances sort in 6 passes instead of 7,
-          * -42 µs on a B580; 4 is worse for the small BLAS. */
-         .morton_sort_kvs_per_thread_64 = 4,
+         /* TLAS (64-bit keys) and big BLAS: fewer merge passes. On a B580,
+          * 43k-instance TLAS -3%, 210k-triangle BLAS -12%; 4 is worse
+          * below ~16k leaves. */
+         .morton_sort_kvs_per_thread_large = 4,
+         .morton_sort_large_leaf_count = 16384,
          /* See struct anv_accel_struct_header from anv_bvh_defines.h
           */
          .bvh_bounds_offset = 0,
diff --git a/src/vulkan/runtime/bvh/vk_bvh_defines.h b/src/vulkan/runtime/bvh/vk_bvh_defines.h
index de6d804b32a..3ccee980b2d 100644
--- a/src/vulkan/runtime/bvh/vk_bvh_defines.h
+++ b/src/vulkan/runtime/bvh/vk_bvh_defines.h
@@ -436,7 +436,9 @@ TYPE(vk_prefix_scan_partition, 4);
 #define VK_BUILD_FLAG_PROPAGATE_CULL_FLAGS (1 << 1)
 #define VK_BUILD_FLAG_64BIT_KEYS (1 << 2)
 #define VK_BUILD_FLAG_HAS_QUADS (1 << 3)
-#define VK_BUILD_FLAG_COUNT 4
+/* Morton sort with morton_sort_kvs_per_thread_large (large inputs) */
+#define VK_BUILD_FLAG_WIDE_SORT (1 << 4)
+#define VK_BUILD_FLAG_COUNT 5
 
 #define VK_LEAF_BUILD_FLAGS (VK_BUILD_FLAG_ALWAYS_ACTIVE | VK_BUILD_FLAG_PROPAGATE_CULL_FLAGS | \
                              VK_BUILD_FLAG_HAS_QUADS)
@@ -449,7 +451,7 @@ struct leaf_args {
    vk_bvh_geometry_data geom_data;
 };
 
-#define VK_MORTON_BUILD_FLAGS (VK_BUILD_FLAG_64BIT_KEYS)
+#define VK_MORTON_BUILD_FLAGS (VK_BUILD_FLAG_64BIT_KEYS | VK_BUILD_FLAG_WIDE_SORT)
 
 struct morton_sort_args {
    VOID_REF bvh;
diff --git a/src/vulkan/runtime/vk_acceleration_structure.c b/src/vulkan/runtime/vk_acceleration_structure.c
index c0f849943c1..360d36afe25 100644
--- a/src/vulkan/runtime/vk_acceleration_structure.c
+++ b/src/vulkan/runtime/vk_acceleration_structure.c
@@ -257,12 +257,21 @@ vk_acceleration_structure_build_state_init(struct vk_acceleration_structure_buil
 
    uint32_t keyval_size = state->config.u64_keys ? sizeof(struct key64_id_pair) : sizeof(struct key32_id_pair);
    uint32_t morton_kvs_per_thread = args->morton_sort_kvs_per_thread;
-   if (state->config.u64_keys && args->morton_sort_kvs_per_thread_64)
-      morton_kvs_per_thread = args->morton_sort_kvs_per_thread_64;
+   if (args->morton_sort_kvs_per_thread_large &&
+       (state->config.u64_keys || leaf_count >= args->morton_sort_large_leaf_count)) {
+      morton_kvs_per_thread = args->morton_sort_kvs_per_thread_large;
+      state->config.build_flags |= VK_BUILD_FLAG_WIDE_SORT;
+   }
    uint32_t morton_keyvals_per_workgroup = args->morton_sort_workgroup_size * morton_kvs_per_thread;
    state->morton_sort_dispatch_size = DIV_ROUND_UP(leaf_count, morton_keyvals_per_workgroup);
    state->morton_sort_passes = util_logbase2_ceil(state->morton_sort_dispatch_size) + 1;
-   uint32_t morton_sort_internal_size = state->morton_sort_passes * sizeof(struct morton_ready_count);
+   /* Sized for the narrow sort: the size query sees the max primitive
+    * count and a build may sort fewer leaves with the narrow variant. */
+   uint32_t narrow_passes =
+      util_logbase2_ceil(DIV_ROUND_UP(leaf_count, args->morton_sort_workgroup_size *
+                                                  args->morton_sort_kvs_per_thread)) + 1;
+   uint32_t morton_sort_internal_size =
+      MAX2(state->morton_sort_passes, narrow_passes) * sizeof(struct morton_ready_count);
 
    uint32_t ir_leaf_size = vk_ir_node_size(vk_get_as_geometry_type(build_info), state->config.build_flags);
 
@@ -724,19 +733,19 @@ morton_generate(VkCommandBuffer commandBuffer, struct vk_device *device,
    VkPipelineLayout layout;
 
    VkResult result;
+   struct vk_acceleration_structure_build_args sort_args = *args;
+   if (build_flags & VK_BUILD_FLAG_WIDE_SORT)
+      sort_args.morton_sort_kvs_per_thread = args->morton_sort_kvs_per_thread_large;
    if (build_flags & VK_BUILD_FLAG_64BIT_KEYS) {
-      struct vk_acceleration_structure_build_args args64 = *args;
-      if (args->morton_sort_kvs_per_thread_64)
-         args64.morton_sort_kvs_per_thread = args->morton_sort_kvs_per_thread_64;
       result = vk_get_bvh_build_pipeline_spv(device, meta, VK_META_OBJECT_KEY_MORTON,
                                              morton64_spv, sizeof(morton64_spv),
-                                             sizeof(struct morton_sort_args), &args64,
+                                             sizeof(struct morton_sort_args), &sort_args,
                                              build_flags, &pipeline,
                                              false /* unaligned_dispatch */);
    } else {
       result = vk_get_bvh_build_pipeline_spv(device, meta, VK_META_OBJECT_KEY_MORTON,
                                              morton32_spv, sizeof(morton32_spv),
-                                             sizeof(struct morton_sort_args), args,
+                                             sizeof(struct morton_sort_args), &sort_args,
                                              build_flags, &pipeline,
                                              false /* unaligned_dispatch */);
    }
diff --git a/src/vulkan/runtime/vk_acceleration_structure.h b/src/vulkan/runtime/vk_acceleration_structure.h
index dd6fc9f5148..91c74235bff 100644
--- a/src/vulkan/runtime/vk_acceleration_structure.h
+++ b/src/vulkan/runtime/vk_acceleration_structure.h
@@ -148,11 +148,13 @@ struct vk_acceleration_structure_build_args {
    uint32_t root_flags_offset;
    uint32_t morton_sort_workgroup_size;
    uint32_t morton_sort_kvs_per_thread;
-   /* Key-values per thread of the 64-bit key sort (TLAS on most drivers);
-    * 0 = morton_sort_kvs_per_thread. Fewer, wider workgroups mean fewer
-    * globally synchronized merge passes for large inputs.
+   /* Key-values per thread of the morton sort for large inputs: 64-bit keys
+    * (TLAS on most drivers) and builds of at least morton_sort_large_leaf_count
+    * leaves. 0 = always morton_sort_kvs_per_thread. Fewer, wider workgroups
+    * mean fewer globally synchronized merge passes.
     */
-   uint32_t morton_sort_kvs_per_thread_64;
+   uint32_t morton_sort_kvs_per_thread_large;
+   uint32_t morton_sort_large_leaf_count;
    bool propagate_cull_flags;
    bool emit_markers;
    bool has_update;
