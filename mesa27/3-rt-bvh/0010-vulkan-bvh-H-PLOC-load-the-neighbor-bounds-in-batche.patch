From 4083d2419d2e90dcfc8c3103dcbda7d6adcdd492 Mon Sep 17 00:00:00 2001
From: askimi <44218719+RNI4114@users.noreply.github.com>
Date: Sun, 4 Oct 2026 21:13:03 -0300
Subject: [PATCH 10/21] vulkan/bvh: H-PLOC: load the neighbor bounds in batches

The nearest-neighbor search read node_aabbs[index].min and .max right before
using them, which brw compiles into two dependent shared memory round trips
per neighbor (32 per merge iteration), on the critical path of every level.
Load the neighbors 4 at a time before using them.

Same tree. TLAS of 43.4k instances on a B580 (tlascheck): 0.55 -> 0.48 ms.
A radius of 4 instead of 16 would give 0.41 ms with the same trace time in
tlascheck, but changes the tree, so it is not done here.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
(cherry picked from commit 7bb8fa1925d10782654cd4af131cd495c31ce45d)
(cherry picked from commit 254b639285d2cd5a2947d08145e77ec50ecb78e4)
---
 src/vulkan/runtime/bvh/hploc_internal.comp | 41 ++++++++++++++--------
 1 file changed, 27 insertions(+), 14 deletions(-)

diff --git a/src/vulkan/runtime/bvh/hploc_internal.comp b/src/vulkan/runtime/bvh/hploc_internal.comp
index 47d9745503f..17012d2d85a 100644
--- a/src/vulkan/runtime/bvh/hploc_internal.comp
+++ b/src/vulkan/runtime/bvh/hploc_internal.comp
@@ -299,20 +299,33 @@ main(void)
             if (gl_SubgroupInvocationID < node_count) {
                candidate_infos[gl_SubgroupInvocationID] = 0xffffffff;
                uint32_t best_candidate = 0xffffffff;
-               for (uint32_t i = 1; i <= SEARCH_RADIUS; i++) {
-                  int32_t index = int32_t(gl_SubgroupInvocationID) - int(i);
-
-                  vk_aabb shared_bounds;
-                  shared_bounds.min = min(node_aabbs[index].min, node_aabb.min);
-                  shared_bounds.max = max(node_aabbs[index].max, node_aabb.max);
-
-                  uint32_t shared_sa = (floatBitsToUint(aabb_surface_area(shared_bounds)) << 1u) & (~(SUBGROUP_SIZE - 1));
-                  if (index >= 0) {
-                     uint32_t candidate = shared_sa | index;
-                     best_candidate = min(best_candidate, candidate);
-
-                     candidate = shared_sa | gl_SubgroupInvocationID;
-                     atomicMin(candidate_infos[index], candidate);
+               /* Neighbors are loaded in batches, all loads of a batch before any use: one shared
+                * memory round trip per batch instead of two per neighbor, on the critical path of
+                * every level.
+                */
+               const uint32_t batch = 4;
+               for (uint32_t i0 = 1; i0 <= SEARCH_RADIUS; i0 += batch) {
+                  vk_aabb neighbors[batch];
+                  [[unroll]]
+                  for (uint32_t j = 0; j < batch; j++)
+                     neighbors[j] = node_aabbs[max(int32_t(gl_SubgroupInvocationID) - int(i0 + j), 0)];
+
+                  [[unroll]]
+                  for (uint32_t j = 0; j < batch; j++) {
+                     int32_t index = int32_t(gl_SubgroupInvocationID) - int(i0 + j);
+
+                     vk_aabb shared_bounds;
+                     shared_bounds.min = min(neighbors[j].min, node_aabb.min);
+                     shared_bounds.max = max(neighbors[j].max, node_aabb.max);
+
+                     uint32_t shared_sa = (floatBitsToUint(aabb_surface_area(shared_bounds)) << 1u) & (~(SUBGROUP_SIZE - 1));
+                     if (index >= 0) {
+                        uint32_t candidate = shared_sa | index;
+                        best_candidate = min(best_candidate, candidate);
+
+                        candidate = shared_sa | gl_SubgroupInvocationID;
+                        atomicMin(candidate_infos[index], candidate);
+                     }
                   }
                }
 
